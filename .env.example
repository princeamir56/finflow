# ===== Gateway =====
GATEWAY_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ===== JWT =====
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=24h

# ===== gRPC service endpoints (as seen by the gateway) =====
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=50051
TRANSACTION_GRPC_HOST=localhost
TRANSACTION_GRPC_PORT=50052
NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=50053

# ===== Kafka =====
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finflow

# ===== Databases =====
AUTH_DB_PATH=./data/auth.db
TRANSACTION_DB_PATH=./data/transaction.db
NOTIFICATION_DB_NAME=finflow_notifications
